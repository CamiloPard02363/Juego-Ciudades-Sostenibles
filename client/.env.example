# Copiar como .env para desarrollo local, o pegar como variable de entorno
# en el panel de Vercel/Netlify para producción.

# URL base del backend NestJS.
# Local: http://localhost:3000
# Producción: https://tu-backend.up.railway.app
VITE_API_URL=http://localhost:3000

# Client ID de OAuth (mismo valor que GOOGLE_CLIENT_ID del backend) para
# cargar el botón de Google Identity Services en el login (issue #197).
# Público por naturaleza — no es un secreto, va embebido en el bundle del cliente.
VITE_GOOGLE_CLIENT_ID=
