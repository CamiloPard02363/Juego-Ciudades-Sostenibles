# Copiar como .env para desarrollo local, o pegar como variables de entorno
# en el panel de Railway (u otro host) para producción.

# --- Bases de datos ---
# Local (docker-compose.yml en la raíz): postgresql://postgres:postgres@localhost:5432/juego_sostenibilidad
# Producción: connection string de Neon (o Supabase/RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/juego_sostenibilidad

# Local (docker-compose.yml en la raíz): incluye replicaSet=rs0 — necesario
# para que el driver de Mongo pueda abrir transacciones (ver
# ImportGamesBatchUseCase). El mongo de docker-compose ya arranca como
# replica set de un solo nodo, así que esto es obligatorio, no opcional.
# Producción: connection string de MongoDB Atlas (los clústeres de Atlas ya
# son replica sets por defecto, no hace falta agregar el parámetro).
MONGODB_URI=mongodb://admin:admin@localhost:27017/?replicaSet=rs0&authSource=admin

# --- Auth ---
# Producción: generar uno largo y aleatorio, nunca reusar el de desarrollo.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m

# OAuth Client ID (tipo "Web application") creado en GCP Console para login
# con Google Identity Services (issue #197). Debe tener registrados los
# orígenes JS autorizados del frontend (ej. http://localhost:5173 y el
# dominio de producción) — sin coincidir, Google rechaza el idToken antes de
# que este backend lo verifique con google-auth-library.
GOOGLE_CLIENT_ID=

# --- CORS ---
# Dominios del frontend permitidos, separados por coma (sin espacios).
# Producción: https://tu-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# --- Cloudinary (subida de imágenes/audio) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gemini / Google AI Studio (asistente de IA que configura juegos desde archivos subidos) ---
# Generar una key propia en Google AI Studio (https://aistudio.google.com/apikey).
# Sin esto, GeminiContentAssistant responde 503 en vez de fallar en silencio.
GOOGLE_IA_STUDIO_API_KEY=
# Máximo de llamadas a Gemini por minuto (se espacian, nunca se disparan
# todas de golpe — ver GeminiContentAssistant.throttle). Por defecto 5, el
# límite del plan gratuito. Súbelo si el proyecto de Google Cloud pasa a un
# plan de pago con más cuota (https://ai.google.dev/gemini-api/docs/rate-limits).
GOOGLE_IA_STUDIO_MAX_RPM=5
# Solo referencia (de qué proyecto de Google Cloud/AI Studio viene la key);
# el código no los usa — la autenticación es 100% con GOOGLE_IA_STUDIO_API_KEY.
NOMBRE=
NOMBRE_PROTJECT=
NUMERO_PROYECTO=

# --- Groq (proveedor de IA del asistente que configura juegos) ---
# Groq es el proveedor de IA activo. Generar una key gratis en
# https://console.groq.com. Sin esto, el asistente responde 503 con un mensaje
# claro ("falta GROQ_API_KEY") en vez de fallar en silencio.
GROQ_API_KEY=
# Modelo de TEXTO (arma el contenido y la configuración de cada juego).
GROQ_MODEL=openai/gpt-oss-120b
# Modelo con VISIÓN (lee las imágenes que sube el usuario: apuntes, fotos,
# capturas). Los modelos gpt-oss son solo texto, por eso es otro modelo.
# Verificado con la cuenta del proyecto; si la tuya no lo tiene, el asistente
# sigue funcionando con texto y avisa que no pudo leer las imágenes.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Máximo de llamadas a Groq por minuto (ver infrastructure/ai/rate-limiter.ts).
GROQ_MAX_RPM=25
# Tope de tokens por petición. El free tier de Groq rechaza (413) una sola
# petición que pase de 8.000 tokens por minuto en gpt-oss-120b; el asistente
# recorta el texto fuente para quedar por debajo y reintenta con la mitad si
# aun así lo rechazan. En una cuenta de pago puedes subirlo para leer textos
# más largos. GROQ_MAX_OUTPUT_TOKENS es lo que se reserva para la respuesta.
GROQ_MAX_REQUEST_TOKENS=7000
GROQ_MAX_OUTPUT_TOKENS=3200
# Cuánto "piensa" el modelo gpt-oss antes de responder: low | medium | high.
# "low" gasta menos tokens por minuto y alcanza para armar un borrador.
GROQ_REASONING_EFFORT=low
# Orden de la cadena de proveedores, separado por coma, por nombre de proveedor
# ("gemini", "groq"). Vacío (default) = "groq". Gemini ya no se usa; para
# reactivarlo como respaldo: "groq,gemini". Ver game.module.ts.
AI_PROVIDER_ORDER=groq
# Tiempo máximo (en segundos) para leer con IA las imágenes que sube el
# usuario en UNA generación. Pasado ese plazo, las que faltan se dejan sin
# leer (se guían por el nombre del archivo) y se le avisa, en vez de hacerlo
# esperar minutos: el free tier de Groq lee pocas imágenes por minuto.
AI_VISION_BUDGET_SECONDS=90

# --- Imágenes automáticas del asistente de IA (issues #240 y #21) ---
# Si el usuario sube sus imágenes, SIEMPRE se usan esas. Cuando un juego con
# imagen por elemento (¿Quién Es?, Parejas) se genera sin imágenes, la IA
# consigue una por elemento, probando estas fuentes en orden:
#   wikimedia → una foto libre de Wikipedia/Wikimedia Commons (gratis, sin API key)
#   ai        → una ilustración básica (emoji + color elegidos por la IA); siempre
#               se puede crear, así que ninguna tarjeta queda sin imagen
# Ambas se suben a Cloudinary (si no está configurado, la ilustración va
# embebida en la propia URL). Cambia el orden o deja una sola: "ai" = nunca
# consultar Wikimedia; "wikimedia" = nunca crear ilustraciones (lo que no se
# encuentre queda para completar a mano).
AI_CONTENT_IMAGE_SOURCES=wikimedia,ai
# Wikimedia pide un User-Agent que identifique la app y un contacto; vacío = el
# de por defecto (nombre de la app + URL del repositorio).
WIKIMEDIA_USER_AGENT=

# --- Servidor ---
# Railway inyecta PORT automáticamente; en local usa 3000 por defecto si se omite.
PORT=3000
NODE_ENV=development

# --- Analítica de uso (BI) ---
# En "false" (o si se omite), el backend no escribe nada en la colección
# analytics_events de Mongo. Actívala solo en entornos donde la cuota de
# almacenamiento no sea un riesgo (ej. producción real, no en pruebas locales).
ANALYTICS_ENABLED=false
