// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RoleModel {
  id        String      @id @default(uuid())
  name      String      @unique
  createdAt DateTime    @default(now()) @map("created_at")
  users     UserModel[]

  @@map("roles")
}

model UserModel {
  id                      String                        @id @default(uuid())
  email                   String                        @unique
  passwordHash            String                        @map("password_hash")
  firstName               String                        @map("first_name")
  middleName              String?                       @map("middle_name")
  lastName                String                        @map("last_name")
  displayName             String                        @map("display_name")
  roleId                  String                        @map("role_id")
  role                    RoleModel                     @relation(fields: [roleId], references: [id])
  avatarUrl               String?                       @map("avatar_url")
  birthDate               DateTime?                     @map("birth_date")
  locale                  String                        @default("es-CO")
  isActive                Boolean                       @default(true) @map("is_active")
  isEmailVerified         Boolean                       @default(false) @map("is_email_verified")
  lastLoginAt             DateTime?                     @map("last_login_at")
  createdAt               DateTime                      @default(now()) @map("created_at")
  lastUpdate              DateTime                      @updatedAt @map("last_update")
  refreshTokens           RefreshTokenModel[]
  organizationsCreated    OrganizationModel[]           @relation("OrganizationCreatedBy")
  organizationMemberships OrganizationMembershipModel[]
  classes                 ClassModel[]
  classEnrollments        ClassEnrollmentModel[]
  subjectsCreated         SubjectModel[]

  @@map("users")
}

/// Rol de un usuario DENTRO de una organización. Eje ortogonal al rol global
/// de plataforma (tabla `roles`): un STUDENT global puede ser ADMIN de una
/// organización. Ver `domain/value-objects/organization-role.vo.ts`.
enum OrganizationRoleEnum {
  STUDENT
  TEACHER
  ADMIN

  @@map("organization_role")
}

model OrganizationModel {
  id              String    @id @default(uuid())
  name            String
  /// Dominio de correo reclamado (ej. "colegio.edu.co"). Único a nivel global:
  /// el constraint es la garantía real ante dos creaciones simultáneas.
  domain          String?   @unique
  createdByUserId String    @map("created_by_user_id")
  createdBy       UserModel @relation("OrganizationCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  /// Desactivada = no admite nuevas matrículas/auto-join, conserva historial
  /// (issue #106, CA2.3). Campo propio, no derivado.
  isActive        Boolean   @default(true) @map("is_active")
  /// Código de invitación estático de la organización (issue #133, Frente A),
  /// generado una vez al crear. Único a nivel global para que
  /// POST /organizations/join lo resuelva sin ambigüedad.
  inviteCode      String    @unique @map("invite_code")

  memberships OrganizationMembershipModel[]
  classes     ClassModel[]

  @@index([createdByUserId])
  @@map("organizations")
}

model OrganizationMembershipModel {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  organization   OrganizationModel    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String               @map("user_id")
  user           UserModel            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgRole        OrganizationRoleEnum @map("org_role")
  joinedAt       DateTime             @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model ClassModel {
  id             String             @id @default(uuid())
  name           String
  description    String             @default("")
  teacherUserId  String             @map("teacher_user_id")
  teacher        UserModel          @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  /// Organización personal del profesor (issue #101). Opcional porque Class
  /// nació sin FK a Organization (agrupador privado vía teacherUserId
  /// solamente, ver issue #80); las clases creadas antes de esta migración
  /// quedan con organizationId null.
  organizationId String?            @map("organization_id")
  organization   OrganizationModel? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /// Código de invitación estático generado una vez al crear la clase (no
  /// rota). Único a nivel global para que POST /classes/join lo resuelva sin
  /// ambigüedad.
  inviteCode     String             @unique @map("invite_code")
  createdAt      DateTime           @default(now()) @map("created_at")
  /// Soft-delete (issue #133, Frente E): desactivada = no admite nuevas
  /// matrículas, pero las ClassEnrollment existentes no se tocan.
  isActive       Boolean            @default(true) @map("is_active")

  games       ClassGameModel[]
  enrollments ClassEnrollmentModel[]

  @@index([teacherUserId, createdAt(sort: Desc)])
  @@index([organizationId])
  @@map("classes")
}

/// Relación N:M entre una Class y un estudiante matriculado (issue #101).
/// Análoga a OrganizationMembership: la identidad real es el par
/// (classId, userId), respaldada por un constraint único compuesto para que
/// unirse dos veces con el mismo inviteCode sea idempotente/no duplique fila.
model ClassEnrollmentModel {
  id         String     @id @default(uuid())
  classId    String     @map("class_id")
  class      ClassModel @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId     String     @map("user_id")
  user       UserModel  @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt DateTime   @default(now()) @map("enrolled_at")

  @@unique([classId, userId])
  @@index([userId])
  @@map("class_enrollments")
}

/// Relación N:M entre una Class (agrupador privado de trabajo del profesor)
/// y un Game (que vive en MongoDB, no en Postgres — de ahí que gameId sea un
/// string suelto sin FK real; la existencia se valida a mano en el use-case
/// contra el repositorio de Game, igual que Subject.categoryId).
model ClassGameModel {
  id      String     @id @default(uuid())
  classId String     @map("class_id")
  class   ClassModel @relation(fields: [classId], references: [id], onDelete: Cascade)
  gameId  String     @map("game_id")
  addedAt DateTime   @default(now()) @map("added_at")

  @@unique([classId, gameId])
  @@index([classId])
  @@map("class_games")
}

enum SubjectStatusEnum {
  PRIVATE
  PUBLIC

  @@map("subject_status")
}

/// Materia raíz (parentSubjectId null, PUBLIC desde su creación por un admin) o
/// sub-materia (parentSubjectId con valor, nace PRIVATE). PRIVATE -> PUBLIC es
/// irreversible; el soft-delete (deletedAt) solo aplica en PRIVATE, porque una
/// materia pública puede tener juegos de otros usuarios colgados debajo.
model SubjectModel {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  parentSubjectId String?           @map("parent_subject_id")
  parent          SubjectModel?     @relation("SubjectHierarchy", fields: [parentSubjectId], references: [id], onDelete: Restrict)
  children        SubjectModel[]    @relation("SubjectHierarchy")
  /// null = materia raíz creada por un admin sin registrar autoría individual.
  creatorUserId   String?           @map("creator_user_id")
  creator         UserModel?        @relation(fields: [creatorUserId], references: [id], onDelete: SetNull)
  status          SubjectStatusEnum @default(PRIVATE)
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([parentSubjectId])
  @@index([creatorUserId])
  @@map("subjects")
}

model RefreshTokenModel {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_tokens")
}
